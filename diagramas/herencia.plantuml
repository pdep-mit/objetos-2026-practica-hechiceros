@startuml
class Hechicero{
    - energiaMaxima: Integer
    - nivel: Integer
    - energiaActual: Integer

    + energiaMaxima(): Integer
    + puedeUsarHechizo(hechizo: Hechizo): Boolean
}

class Aprendiz extends Hechicero{
  + energiaMaxima(): Integer
  + puedeUsarHechizo(hechizo: Hechizo): Boolean
}

class Archimagos extends Hechicero{
  + energiaMaxima(): Integer
  + puedeUsarHechizo(hechizo: Hechizo): Boolean
}

class Supremos extends Hechicero{
  + energiaMaxima(): Integer
  + puedeUsarHechizo(hechizo: Hechizo): Boolean
}

class Hechizo{
    -energia: Integer
    -prohibido: Boolean
    + energiaRequerida(): Integer
    + esProhibido(): Boolean
}

Hechicero .> Hechizo
@enduml