
@startuml

class Hechicero {
    - energiaActual: Number
    - rango: Rango
    + energiaMaxima(): Number
    + puedeUsarHechizo(hechizo: Hechizo): Boolean
    + subirRango(): void
    + cambiarEnergia(nuevaEnergia: Number): void
    + cambiarRango(nuevoRango: Rango): void
}

interface Rango {
    + energiaMaxima(): Number
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

class Aprendiz {
    + energiaMaxima(): Number
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

class Archimago {
    - nivel: Number
    + energiaMaxima(): Number
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

object supremo {
    + energiaMaxima(): Number
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

class Hechizo {
    - energiaRequerida: Number
    - esProhibido: Boolean
    + energiaRequerida(): Number
    + esProhibido(): Boolean
}

Hechicero --> Rango
Hechicero ..> Hechizo

Rango <|.. Aprendiz
Rango <|.. Archimago
Rango <|.. supremo

@enduml
