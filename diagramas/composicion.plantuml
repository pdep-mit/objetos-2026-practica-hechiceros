@startuml

class Hechicero{
    - energiaActual: Integer
    - rango: Integer
    + energiaMaxima(): Integer
    + puedeUsarHechizo(hechizo: Hechizo): Boolean
    + subirRango(): void
    + modificarRango(nuevoRango: Rango): void
}

abstract Rango{
    - energiaMaxima: Integer
    - nivel: Integer
    + energiaMaxima(): Integer
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

object aprendiz{
    + energiaMaxima(): Integer
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

class Archimagos{
    + energiaMaxima(): Integer
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

object supremo{
    + energiaMaxima(): Integer
    + cumpleRequerimiento(hechizo: Hechizo): Boolean
    + subirRango(hechicero: Hechicero): void
}

class Hechizo{
    -energia: Integer
    -prohibido: Boolean
    + energiaRequerida(): Integer
    + esProhibido(): Boolean
}
Rango --> Hechizo
Archimagos ---|> Rango 
supremo ---|> Rango
aprendiz ---|> Rango

@enduml
