
@startuml

class Hechicero {
    - energiaActual
    - rango
    + energiaMaxima()
    + puedeUsarHechizo(hechizo)
    + subirRango()
    + cambiarEnergia(nuevaEnergia)
    + cambiarRango(nuevoRango)
}

interface Rango {
    + energiaMaxima()
    + cumpleRequerimiento(hechizo)
    + subirRango(hechicero)
}

class Aprendiz {
    + energiaMaxima()
    + cumpleRequerimiento(hechizo)
    + subirRango(hechicero)
}

class Archimago {
    - nivel
    + energiaMaxima()
    + cumpleRequerimiento(hechizo)
    + subirRango(hechicero)
}

object supremo {
    + energiaMaxima()
    + cumpleRequerimiento(hechizo)
    + subirRango(hechicero)
}

class Hechizo {
    - energiaRequerida
    - esProhibido
    + energiaRequerida()
    + esProhibido()
}

Hechicero --> Rango
Hechicero ..> Hechizo 

Rango <|.. Aprendiz
Rango <|.. Archimago
Rango <|.. supremo


@enduml
